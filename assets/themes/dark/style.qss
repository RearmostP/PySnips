QWidget { background-color: #1e1e1e; color: #e8e8e8; font-family: "Segoe UI"; font-size: 13px; }
QPushButton { background-color: #2a2a2a; color: #ffffff; border: 1px solid #3a3a3a; border-radius: 4px; padding: 5px 10px; }
QPushButton:hover { background-color: #333333; }
QPushButton:pressed, QPushButton:checked { background-color: #36506b; }
QPushButton:disabled { color: #777777; }
QLineEdit, QPlainTextEdit, QTextBrowser, QComboBox, QListWidget { background-color: #181818; color: #d4d4d4; border: 1px solid #3a3a3a; border-radius: 4px; padding: 6px; selection-background-color: #36506b; }
QPlainTextEdit[codeEditor="true"], QLineEdit[codeEditor="true"] { font-family: "JetBrains Mono", Consolas, monospace; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #1e1e1e; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #454545; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QMenu { background-color: #242424; border: 1px solid #343434; padding: 4px; }
QMenu::item { padding: 6px 22px; }
QMenu::item:selected { background: #36506b; }
QPushButton#open_snips, QPushButton#open_settings { font-size: 18pt; }
QLabel#lbl_app_name { font-size: 14pt; font-weight: bold; }
QLabel#category_title { font-size: 16pt; font-weight: bold; }
QSplitter::handle { background-color: #343434; }
QWidget#SnippetCardWidget { background-color: #202020; border: 1px solid #2d2d2d; border-radius: 6px; }
QWidget#SnippetCardWidget QLabel { background-color: transparent; border: none; }
QWidget#SnippetCardWidget QLabel#title { color: #ffffff; font-family: "Segoe UI", Arial, sans-serif; font-size: 14px; font-weight: bold; }
QWidget#SnippetCardWidget QTextBrowser#content { background-color: #181818; color: #d4d4d4; border: 1px solid #2d2d2d; border-radius: 4px; padding: 8px; font-size: 13px; }
QWidget#SnippetCardWidget QPushButton { color: white; border: none; border-radius: 4px; padding: 4px 8px; font-size: 12px; font-weight: bold; }
QWidget#SnippetCardWidget QPushButton#edit { background-color: #007bff; }
QWidget#SnippetCardWidget QPushButton#edit:hover { background-color: #0056b3; }
QWidget#SnippetCardWidget QPushButton#edit:pressed { background-color: #004085; }
QWidget#SnippetCardWidget QPushButton#details { background-color: #6c757d; }
QWidget#SnippetCardWidget QPushButton#details:hover { background-color: #5a6268; }
QWidget#SnippetCardWidget QPushButton#details:pressed { background-color: #495057; }
QWidget#SnippetCardWidget QPushButton#delete { background-color: #8c1d18; }
QWidget#SnippetCardWidget QPushButton#delete:hover { background-color: #b3261e; }
QWidget#SnippetCardWidget QPushButton#delete:pressed { background-color: #6f1713; }
QWidget#wdg_settings_sidebar { background-color: #242424; border-right: 1px solid #343434; }
QWidget#wdg_settings_sidebar QPushButton { background-color: transparent; color: #d8d8d8; border: none; border-radius: 4px; padding: 7px 10px; text-align: left; font-size: 13px; }
QWidget#wdg_settings_sidebar QPushButton:hover { background-color: #303030; }
QWidget#wdg_settings_sidebar QPushButton[active="true"] { background-color: #36506b; color: #ffffff; }
QWidget#wdg_snips_submenu, QWidget#wdg_snips_submenu QPushButton { background-color: #242424; }
QWidget#wdg_snips_submenu QPushButton { color: #c8c8c8; padding-left: 18px; font-size: 12px; }
QStackedWidget#wdg_settings_pages { background-color: #1e1e1e; }
QWidget#SettingsScreen QLabel { color: #eeeeee; font-size: 16px; font-weight: bold; }
QWidget#SettingsScreen QPushButton#deleted, QWidget#SettingsScreen QPushButton#rebuild { background-color: transparent; color: #4da3ff; border: none; text-align: left; padding: 5px 0; font-size: 13px; font-weight: bold; }
QWidget#SettingsScreen QPushButton#deleted:hover, QWidget#SettingsScreen QPushButton#rebuild:hover { color: #7bbcff; text-decoration: underline; }

/* Create / Edit Snippet: restrained metadata, compact toolbar, focused editor. */
QWidget#CreateSnippetForm QLabel[metadataLabel="true"] { color: #adb3bd; font-size: 12px; font-weight: 600; background: transparent; }
QWidget#CreateSnippetForm QLineEdit, QWidget#CreateSnippetForm QComboBox { background: #252526; color: #d4d7dd; border: 1px solid #34373d; border-radius: 6px; padding: 7px 10px; }
QWidget#CreateSnippetForm QLineEdit:focus, QWidget#CreateSnippetForm QComboBox:focus { border-color: #5683ad; }
QWidget#markdownToolbar { background: #252526; border-radius: 6px; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"] { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 0; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:hover { background: #30343b; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:pressed { background: #36506b; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:focus { border-color: #5683ad; }
QFrame#toolbarSeparator { background: #34373d; border: none; min-width: 1px; max-width: 1px; min-height: 18px; max-height: 18px; margin: 0 4px; }
QWidget#CreateSnippetForm QPlainTextEdit#content, QWidget#CreateSnippetForm QTextBrowser#preview_browser { background: #171819; color: #d4d7dd; border: 1px solid #34373d; border-radius: 7px; padding: 14px; selection-background-color: #36506b; selection-color: #ffffff; }
QWidget#CreateSnippetForm QPlainTextEdit#content { font-family: "JetBrains Mono", Consolas, monospace; font-size: 14px; font-weight: 400; }
QWidget#CreateSnippetForm QPlainTextEdit#content:focus { border-color: #5683ad; }
QWidget#CreateSnippetForm QTextBrowser#preview_browser { font-family: "Segoe UI"; font-size: 13px; }
QWidget#CreateSnippetForm QPushButton#cancel, QWidget#CreateSnippetForm QPushButton#save { border-radius: 6px; padding: 7px 18px; }
QWidget#CreateSnippetForm QPushButton#cancel { background: transparent; color: #d4d7dd; border: 1px solid #34373d; }
QWidget#CreateSnippetForm QPushButton#cancel:hover { background: #30343b; }
QWidget#CreateSnippetForm QPushButton#save { background: #365f87; color: #ffffff; border: 1px solid #365f87; font-weight: 600; }
QWidget#CreateSnippetForm QPushButton#save:hover { background: #406f9c; border-color: #406f9c; }
QWidget#CreateSnippetForm QPushButton#save:pressed { background: #2d5276; border-color: #2d5276; }
QWidget#CreateSnippetForm QPushButton#cancel:focus, QWidget#CreateSnippetForm QPushButton#save:focus { border-color: #5683ad; }

/* Snippet details follows the editor's surfaces and action hierarchy. */
QWidget#SnippetDetails QLabel { background: transparent; color: #d4d7dd; font-size: 14px; }
QWidget#SnippetDetails QLabel#title { font-size: 20px; font-weight: 600; }
QWidget#SnippetDetails QWidget#metadataPanel { background: #252526; border-radius: 6px; }
QWidget#SnippetDetails QWidget#tags { background: transparent; }
QWidget#SnippetDetails QLabel[metadataLabel="true"] { color: #adb3bd; font-size: 12px; }
QWidget#SnippetDetails QLabel[tagBadge="true"] { background: #30343b; border-radius: 4px; padding: 3px 8px; font-size: 12px; }
QWidget#SnippetDetails QPushButton { border-radius: 6px; padding: 7px 18px; }
QWidget#SnippetDetails QPushButton#close { background: transparent; color: #d4d7dd; border: 1px solid #34373d; }
QWidget#SnippetDetails QPushButton#close:hover { background: #30343b; }
QWidget#SnippetDetails QPushButton#edit { background: #365f87; color: #ffffff; border: 1px solid #365f87; font-weight: 600; }
QWidget#SnippetDetails QPushButton#edit:hover { background: #406f9c; border-color: #406f9c; }
QWidget#SnippetDetails QPushButton#edit:pressed { background: #2d5276; border-color: #2d5276; }
QWidget#SnippetDetails QPushButton:focus { border-color: #5683ad; }

/* Snips screen shell only: child search and card styling stays independent. */
QWidget#SnippetsScreen QWidget#wdg_sidebar, QWidget#SnippetsScreen QScrollArea#scl_categories, QWidget#SnippetsScreen QWidget#categories_content { background: #252526; }
QWidget#SnippetsScreen QWidget#wdg_main_content, QWidget#SnippetsScreen QWidget#search_holder, QWidget#SnippetsScreen QScrollArea#scl_snippets, QWidget#SnippetsScreen QWidget#snippets_content { background: #1e1e1e; }
QWidget#SnippetsScreen QSplitter#frm_splitter::handle { background: #34373d; }
QWidget#SnippetsScreen QSplitter#frm_splitter::handle:hover { background: #5683ad; }
QWidget#SnippetsScreen QLabel#lbl_app_name { background: transparent; color: #e8e8e8; font-size: 18px; font-weight: 600; padding: 0 10px 12px; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"], QWidget#SnippetsScreen QPushButton[categoryNav="true"] { background: transparent; color: #adb3bd; border: 1px solid transparent; border-radius: 6px; padding: 6px 10px; text-align: left; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"][navRtl="true"], QWidget#SnippetsScreen QPushButton[categoryNav="true"][navRtl="true"] { text-align: right; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:hover, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:hover { background: #30343b; color: #d4d7dd; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:pressed, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:pressed { background: #36506b; color: #ffffff; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"]:checked { background: #36506b; color: #ffffff; font-weight: 600; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"]:checked:hover { background: #365f87; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:focus, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:focus { border-color: #5683ad; }
QWidget#SnippetsScreen QPushButton#menu::menu-indicator { image: none; }
QWidget#SnippetsScreen QLabel#category_title { background: transparent; color: #d4d7dd; font-size: 20px; font-weight: 600; }
QWidget#SnippetsScreen QLabel#snippets_empty { color: #adb3bd; }
QWidget#SnippetsScreen QPushButton#create { background: #365f87; color: #ffffff; border: 1px solid #365f87; border-radius: 6px; padding: 7px 18px; font-weight: 600; }
QWidget#SnippetsScreen QPushButton#create:hover { background: #406f9c; border-color: #406f9c; }
QWidget#SnippetsScreen QPushButton#create:pressed { background: #2d5276; border-color: #2d5276; }
QWidget#SnippetsScreen QPushButton#create:focus { border-color: #5683ad; }
