QWidget { background-color: #16171B; color: #E8E8E8; font-family: "Segoe UI"; font-size: 13px; }
/* Windows 11's menu indicator reads pointSize(); 9.75pt equals 13px at 96 DPI. */
QWidget#SnippetsScreen QPushButton#menu { font-size: 9.75pt; }
QPushButton { background-color: #202020; color: #E8E8E8; border: 1px solid #2D2D2D; border-radius: 4px; padding: 5px 10px; }
QPushButton:hover { background-color: #303030; }
QPushButton:pressed, QPushButton:checked { background-color: #28303D; }
QPushButton:disabled { color: #A8A8A8; }
QLineEdit, QPlainTextEdit, QTextBrowser, QComboBox, QListWidget { background-color: #181818; color: #D4D4D4; border: 1px solid #2D2D2D; border-radius: 4px; padding: 6px; selection-background-color: #28303D; }
QPlainTextEdit[codeEditor="true"], QLineEdit[codeEditor="true"] { font-family: "JetBrains Mono", Consolas, monospace; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #16171B; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #454545; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QMenu { background-color: #202020; border: 1px solid #343434; padding: 4px; }
QMenu::item { padding: 6px 22px; }
QMenu::item:selected { background: #28303D; }
QPushButton#open_snips, QPushButton#open_settings { font-size: 18pt; }
QLabel#lbl_app_name { font-size: 18px; font-weight: bold; }
QDialog#CloudBackupDialog QLabel#backup_heading { font-size: 20px; font-weight: 600; background: transparent; }
QLabel#category_title { font-size: 18px; font-weight: bold; }
QSplitter::handle { background-color: #343434; }
QWidget#SnippetCardWidget { background-color: #202020; border: 1px solid #2D2D2D; border-radius: 6px; }
QWidget#SnippetCardWidget QLabel { background-color: transparent; border: none; }
QWidget#SnippetCardWidget QLabel#title { color: #ffffff; font-family: "Segoe UI", Arial, sans-serif; font-size: 14px; font-weight: bold; }
QWidget#SnippetCardWidget QTextBrowser#content { background-color: #181818; color: #D4D4D4; border: 1px solid #2D2D2D; border-radius: 4px; padding: 8px; font-size: 13px; font-family: "Segoe UI", Arial, sans-serif; }
QWidget#SnippetCardWidget QPushButton { color: #FFFFFF; border: none; border-radius: 4px; padding: 4px 8px; font-size: 12px; font-weight: bold; }
QWidget#SnippetCardWidget QPushButton#edit { background-color: #007bff; }
QWidget#SnippetCardWidget QPushButton#edit:hover { background-color: #0056b3; }
QWidget#SnippetCardWidget QPushButton#edit:pressed { background-color: #004085; }
QWidget#SnippetCardWidget QPushButton#details { background-color: #6c757d; }
QWidget#SnippetCardWidget QPushButton#details:hover { background-color: #5a6268; }
QWidget#SnippetCardWidget QPushButton#details:pressed { background-color: #495057; }
QWidget#SnippetCardWidget QPushButton#delete { background-color: #8c1d18; }
QWidget#SnippetCardWidget QPushButton#delete:hover { background-color: #b3261e; }
QWidget#SnippetCardWidget QPushButton#delete:pressed { background-color: #6f1713; }

/* Create / Edit Snippet: restrained metadata, compact toolbar, focused editor. */
QWidget#CreateSnippetForm QLabel[metadataLabel="true"] { color: #C8C8C8; font-size: 12px; font-weight: 600; background: transparent; }
QWidget#CreateSnippetForm QLineEdit, QWidget#CreateSnippetForm QComboBox { background: #181818; color: #E8E8E8; border: 1px solid #2D2D2D; border-radius: 6px; padding: 7px 10px; }
QWidget#CreateSnippetForm QLineEdit:focus, QWidget#CreateSnippetForm QComboBox:focus { border-color: #7086A8; }
QWidget#markdownToolbar { background: #202020; border-radius: 6px; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"] { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 0; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:hover { background: #303030; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:pressed { background: #28303D; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:focus { border-color: #7086A8; }
QFrame#toolbarSeparator { background: #343434; border: none; min-width: 1px; max-width: 1px; min-height: 18px; max-height: 18px; margin: 0 4px; }
QWidget#CreateSnippetForm QPlainTextEdit#content, QWidget#CreateSnippetForm QTextBrowser#preview_browser { background: #181818; color: #D4D4D4; border: 1px solid #2D2D2D; border-radius: 7px; padding: 14px; selection-background-color: #28303D; selection-color: #E8E8E8; }
QWidget#CreateSnippetForm QPlainTextEdit#content { font-family: "JetBrains Mono", Consolas, monospace; font-size: 14px; font-weight: 400; }
QWidget#CreateSnippetForm QPlainTextEdit#content:focus { border-color: #7086A8; }
QWidget#CreateSnippetForm QTextBrowser#preview_browser { font-family: "Segoe UI"; font-size: 13px; }
QWidget#CreateSnippetForm QPushButton#cancel, QWidget#CreateSnippetForm QPushButton#save { border-radius: 6px; padding: 7px 18px; }
QWidget#CreateSnippetForm QPushButton#cancel { background: transparent; color: #E8E8E8; border: 1px solid #2D2D2D; }
QWidget#CreateSnippetForm QPushButton#cancel:hover { background: #303030; }
QWidget#CreateSnippetForm QPushButton#save { background: #6C7DFF; color: #E8E8E8; border: 1px solid #6C7DFF; font-weight: 600; }
QWidget#CreateSnippetForm QPushButton#save:hover { background: #7888FF; border-color: #7888FF; }
QWidget#CreateSnippetForm QPushButton#save:pressed { background: #6575EE; border-color: #6575EE; }
QWidget#CreateSnippetForm QPushButton#cancel:focus, QWidget#CreateSnippetForm QPushButton#save:focus { border-color: #7086A8; }

/* Snippet details follows the editor's surfaces and action hierarchy. */
QWidget#SnippetDetails QLabel { background: transparent; color: #E8E8E8; font-size: 14px; }
QWidget#SnippetDetails QLabel#title { font-size: 20px; font-weight: 600; }
QWidget#SnippetDetails QWidget#metadataPanel { background: #202020; border-radius: 6px; }
QWidget#SnippetDetails QWidget#tags { background: transparent; }
QWidget#SnippetDetails QLabel[metadataLabel="true"] { color: #C8C8C8; font-size: 12px; }
QWidget#SnippetDetails QLabel[tagBadge="true"] { background: #303030; border-radius: 4px; padding: 3px 8px; font-size: 12px; }
QWidget#SnippetDetails QPushButton { border-radius: 6px; padding: 7px 18px; }
QWidget#SnippetDetails QPushButton#close { background: transparent; color: #E8E8E8; border: 1px solid #2D2D2D; }
QWidget#SnippetDetails QPushButton#close:hover { background: #303030; }
QWidget#SnippetDetails QPushButton#edit { background: #6C7DFF; color: #E8E8E8; border: 1px solid #6C7DFF; font-weight: 600; }
QWidget#SnippetDetails QPushButton#edit:hover { background: #7888FF; border-color: #7888FF; }
QWidget#SnippetDetails QPushButton#edit:pressed { background: #6575EE; border-color: #6575EE; }
QWidget#SnippetDetails QPushButton:focus { border-color: #7086A8; }

/* Snips shell only: search inherits the global dark control style. */
QWidget#SnippetsScreen { background: #16171B; }
QWidget#SnippetsScreen QWidget#wdg_sidebar, QWidget#SnippetsScreen QScrollArea#scl_categories, QWidget#SnippetsScreen QWidget#categories_content { background: #1E1E1E; }
QWidget#SnippetsScreen QWidget#wdg_main_content, QWidget#SnippetsScreen QWidget#search_holder, QWidget#SnippetsScreen QScrollArea#scl_snippets, QWidget#SnippetsScreen QWidget#snippets_content { background: #16171B; }
QWidget#SnippetsScreen QSplitter#frm_splitter::handle { background: #2D2D2D; }
QWidget#SnippetsScreen QLabel#lbl_app_name { background: transparent; color: #E8E8E8; font-size: 18px; font-weight: bold; padding: 0; }
QWidget#SnippetsScreen QLabel#category_title { background: transparent; color: #E8E8E8; font-size: 18px; font-weight: bold; }
QWidget#SnippetsScreen QLabel#snippets_empty { background: transparent; color: #E8E8E8; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"], QWidget#SnippetsScreen QPushButton[categoryNav="true"] { background: #2A2A2A; color: #FFFFFF; border: 1px solid #3A3A3A; border-radius: 4px; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:hover, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:hover { background: #333333; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:pressed, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:pressed { background: #242424; }
QWidget#SnippetsScreen QPushButton#create { background: #2A2A2A; color: #FFFFFF; border: 1px solid #3A3A3A; border-radius: 6px; font-weight: 600; }
QWidget#SnippetsScreen QPushButton#create:hover { background: #333333; border-color: #3A3A3A; }
QWidget#SnippetsScreen QPushButton#create:pressed { background: #242424; border-color: #3A3A3A; }

/* Compact application About dialog. */
QWidget#AboutForm QLabel { background: transparent; color: #E8E8E8; font-size: 12px; }
QWidget#AboutForm QLabel#product_name { font-size: 20px; font-weight: 600; }
QWidget#AboutForm QLabel[aboutMuted="true"] { color: #C8C8C8; }
QWidget#AboutForm QLabel#version { font-size: 13px; }
QWidget#AboutForm QPushButton[aboutLink="true"] { background: transparent; color: #4DA3FF; border: 1px solid transparent; border-radius: 0; padding: 1px 0; font-size: 12px; text-align: left; }
QWidget#AboutForm QPushButton[aboutLink="true"]:hover { color: #7BBCFF; text-decoration: underline; }
QWidget#AboutForm QPushButton[aboutLink="true"]:focus { border-bottom-color: #6C7DFF; }
QWidget#AboutForm QPushButton#close { background: transparent; color: #E8E8E8; border: 1px solid #2D2D2D; border-radius: 6px; padding: 5px 14px; }
QWidget#AboutForm QPushButton#close:hover { background: #303030; }
QWidget#AboutForm QPushButton#close:focus { border-color: #7086A8; }

/* Settings: one flat page with compact controls and quiet section dividers. */
QWidget#SettingsScreen QLabel#page_title { background: transparent; color: #E8E8E8; font-size: 20px; font-weight: 600; }
QWidget#SettingsScreen QLabel[settingsSection="true"] { background: transparent; color: #E8E8E8; font-size: 15px; font-weight: 600; border-bottom: 1px solid #343434; padding-bottom: 8px; }
QWidget#SettingsScreen QLabel[settingsRowTitle="true"] { background: transparent; color: #E8E8E8; font-weight: 600; }
QWidget#SettingsScreen QLabel[settingsDescription="true"] { background: transparent; color: #C8C8C8; font-size: 12px; }
QWidget#SettingsScreen QComboBox[settingsControl="true"] { background: #181818; color: #E8E8E8; border: 1px solid #2D2D2D; border-radius: 6px; padding: 6px 10px; }
QWidget#SettingsScreen QComboBox[settingsControl="true"]:focus { border-color: #7086A8; }
QWidget#SettingsScreen QPushButton[settingsControl="true"] { background: #202020; color: #E8E8E8; border: 1px solid #2D2D2D; border-radius: 6px; padding: 6px 14px; }
QWidget#SettingsScreen QPushButton[settingsControl="true"]:hover { background: #303030; }
QWidget#SettingsScreen QPushButton[settingsControl="true"]:pressed { background: #28303D; }
QWidget#SettingsScreen QPushButton[settingsControl="true"]:focus { border-color: #7086A8; }
QWidget#SettingsScreen QCheckBox[settingsControl="true"]::indicator { width: 18px; height: 18px; }
QWidget#SettingsScreen QCheckBox[settingsControl="true"]::indicator:unchecked { background: #181818; border: 1px solid #454545; border-radius: 4px; }
QWidget#SettingsScreen QCheckBox[settingsControl="true"]::indicator:unchecked:hover { border-color: #7086A8; }
QWidget#SettingsScreen QPushButton#back { background: transparent; color: #C8C8C8; border: 1px solid transparent; border-radius: 6px; padding: 4px 8px; }
QWidget#SettingsScreen QPushButton#back:hover { background: #303030; color: #E8E8E8; }
QWidget#SettingsScreen QPushButton#back:focus { border-color: #7086A8; }

/* Palette-only control states; existing dimensions and layout stay unchanged. */
QLineEdit, QPlainTextEdit, QComboBox { placeholder-text-color: #A8A8A8; selection-color: #E8E8E8; }
QLineEdit:focus, QPlainTextEdit:focus, QTextBrowser:focus, QComboBox:focus, QListWidget:focus, QPushButton:focus { border-color: #7086A8; }
QComboBox QAbstractItemView { background: #181818; color: #E8E8E8; border-color: #2D2D2D; selection-background-color: #28303D; selection-color: #E8E8E8; }
QWidget#SnippetCardWidget QPushButton#edit { color: #ffffff; }
QWidget#CreateSnippetForm QPushButton#save, QWidget#SnippetDetails QPushButton#edit { color: #16171B; }
QWidget#SettingsScreen QCheckBox[settingsControl="true"]::indicator:checked { background: #6C7DFF; border-color: #6C7DFF; }
QWidget#SettingsScreen QCheckBox[settingsControl="true"]::indicator:focus { border-color: #C8C8C8; }
QWidget QPushButton:disabled, QWidget QLineEdit:disabled, QWidget QPlainTextEdit:disabled, QWidget QComboBox:disabled { background: #202020; color: #A8A8A8; border-color: #343434; }
QWidget#CreateSnippetForm QPushButton:disabled, QWidget#SnippetDetails QPushButton:disabled, QWidget#SettingsScreen QPushButton:disabled { background: #202020; color: #A8A8A8; border-color: #343434; }
/* Content card: a shared header, quiet metadata badges and compact actions. */
QWidget#SnippetCardWidget QWidget#cardHeader, QWidget#SnippetCardWidget QWidget#cardActions, QWidget#SnippetCardWidget QWidget#cardTags { background: transparent; border: none; }
QWidget#SnippetCardWidget QLabel[tagBadge="true"] { background: #181818; color: #D4D4D4; border: 1px solid #2D2D2D; border-radius: 4px; padding: 2px 7px; font-size: 11px; font-weight: 400; }

/* Snips navigation and surfaces matched to the reference screen. */
QWidget#SnippetsScreen QWidget#wdg_sidebar, QWidget#SnippetsScreen QScrollArea#scl_categories, QWidget#SnippetsScreen QWidget#categories_content { background: #1D2025; }
QWidget#SnippetsScreen QSplitter#frm_splitter::handle { background: #2C3339; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"] { background: transparent; color: #E8E8E8; border: none; border-radius: 4px; text-align: left; padding: 8px 12px; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"]:hover { background: #252830; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"]:pressed { background: #2C3038; }
QWidget#SnippetsScreen QPushButton#menu { background: transparent; border: none; padding: 0; }
QWidget#SnippetsScreen QPushButton#menu:hover { background: #252830; }
QWidget#SnippetsScreen QPushButton#menu::menu-indicator { image: none; width: 0; height: 0; }
QWidget#SnippetsScreen QPushButton#add_category { background: #252830; border: 1px solid #30343C; border-radius: 6px; }
QWidget#SnippetsScreen QPushButton#add_category:hover { background: #2E323B; }
QWidget#SnippetsScreen QPushButton#create { background: #6C7DFF; color: #FFFFFF; border: none; border-radius: 6px; padding: 6px 14px; font-weight: 600; }
QWidget#SnippetsScreen QPushButton#create:hover { background: #7888FF; }
QWidget#SnippetsScreen QPushButton#create:pressed { background: #6575EE; }
QWidget#SnippetsScreen QLineEdit#query { background: #1D2025; border: 1px solid #34383F; border-radius: 6px; padding: 8px 10px; }

/* Open snippet card with a bordered content preview. */
QWidget#SnippetCardWidget { background: transparent; border: none; border-radius: 0; }
QWidget#SnippetCardWidget QLabel#title { color: #E8E8E8; font-weight: 600; }
QWidget#SnippetCardWidget QTextBrowser#content { background: #191C21; color: #E8E8E8; border: 1px solid #34383F; border-radius: 6px; padding: 10px 12px; }
QWidget#SnippetCardWidget QPushButton { color: #FFFFFF; border-radius: 5px; padding: 4px 8px; font-weight: normal; }
QWidget#SnippetCardWidget QPushButton#details { background: #252830; border: 1px solid #34383F; }
QWidget#SnippetCardWidget QPushButton#details:hover { background: #30343C; }
QWidget#SnippetCardWidget QPushButton#details:pressed { background: #20232A; }
QWidget#SnippetCardWidget QPushButton#edit { background: #6C7DFF; }
QWidget#SnippetCardWidget QPushButton#edit:hover { background: #7888FF; }
QWidget#SnippetCardWidget QPushButton#edit:pressed { background: #6575EE; }
QWidget#SnippetCardWidget QPushButton#delete { background: #E85555; }
QWidget#SnippetCardWidget QPushButton#delete:hover { background: #F16666; }
QWidget#SnippetCardWidget QPushButton#delete:pressed { background: #CF4646; }
