QWidget { background-color: #f0f0f0; color: #202020; font-family: "Segoe UI"; font-size: 13px; }
QPushButton { background-color: #f5f5f5; color: #202020; border: 1px solid #bcbcbc; border-radius: 4px; padding: 5px 10px; }
QPushButton:hover { background-color: #e3e3e3; }
QPushButton:pressed, QPushButton:checked { background-color: #d6e8fa; }
QPushButton:disabled { color: #777777; }
QLineEdit, QPlainTextEdit, QTextBrowser, QComboBox, QListWidget { background-color: #ffffff; color: #202020; border: 1px solid #bcbcbc; border-radius: 4px; padding: 6px; selection-background-color: #d6e8fa; }
QPlainTextEdit[codeEditor="true"], QLineEdit[codeEditor="true"] { font-family: "JetBrains Mono", Consolas, monospace; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #f0f0f0; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #bcbcbc; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QMenu { background-color: #e8e8e8; border: 1px solid #cccccc; padding: 4px; }
QMenu::item { padding: 6px 22px; }
QMenu::item:selected { background: #d6e8fa; }
QPushButton#open_snips, QPushButton#open_settings { font-size: 18pt; }
QLabel#lbl_app_name { font-size: 14pt; font-weight: bold; }
QLabel#category_title { font-size: 16pt; font-weight: bold; }
QSplitter::handle { background-color: #cccccc; }
QWidget#SnippetCardWidget { background-color: #fafafa; border: 1px solid #d0d0d0; border-radius: 6px; }
QWidget#SnippetCardWidget QLabel { background-color: transparent; border: none; }
QWidget#SnippetCardWidget QLabel#title { color: #202020; font-family: "Segoe UI", Arial, sans-serif; font-size: 14px; font-weight: bold; }
QWidget#SnippetCardWidget QTextBrowser#content { background-color: #ffffff; color: #202020; border: 1px solid #d0d0d0; border-radius: 4px; padding: 8px; font-size: 13px; }
QWidget#SnippetCardWidget QPushButton { color: white; border: none; border-radius: 4px; padding: 4px 8px; font-size: 12px; font-weight: bold; }
QWidget#SnippetCardWidget QPushButton#edit { background-color: #007bff; }
QWidget#SnippetCardWidget QPushButton#edit:hover { background-color: #0056b3; }
QWidget#SnippetCardWidget QPushButton#edit:pressed { background-color: #004085; }
QWidget#SnippetCardWidget QPushButton#details { background-color: #6c757d; }
QWidget#SnippetCardWidget QPushButton#details:hover { background-color: #5a6268; }
QWidget#SnippetCardWidget QPushButton#details:pressed { background-color: #495057; }
QWidget#SnippetCardWidget QPushButton#delete { background-color: #8c1d18; }
QWidget#SnippetCardWidget QPushButton#delete:hover { background-color: #b3261e; }
QWidget#SnippetCardWidget QPushButton#delete:pressed { background-color: #6f1713; }
QWidget#wdg_settings_sidebar { background-color: #e8e8e8; border-right: 1px solid #cccccc; }
QWidget#wdg_settings_sidebar QPushButton { background-color: transparent; color: #202020; border: none; border-radius: 4px; padding: 7px 10px; text-align: left; font-size: 13px; }
QWidget#wdg_settings_sidebar QPushButton:hover { background-color: #dadada; }
QWidget#wdg_settings_sidebar QPushButton[active="true"] { background-color: #d6e8fa; color: #202020; }
QWidget#wdg_snips_submenu, QWidget#wdg_snips_submenu QPushButton { background-color: #e8e8e8; }
QWidget#wdg_snips_submenu QPushButton { color: #303030; padding-left: 18px; font-size: 12px; }
QStackedWidget#wdg_settings_pages { background-color: #f0f0f0; }
QWidget#SettingsScreen QLabel { color: #202020; font-size: 16px; font-weight: bold; }
QWidget#SettingsScreen QPushButton#deleted, QWidget#SettingsScreen QPushButton#rebuild { background-color: transparent; color: #0066b8; border: none; text-align: left; padding: 5px 0; font-size: 13px; font-weight: bold; }
QWidget#SettingsScreen QPushButton#deleted:hover, QWidget#SettingsScreen QPushButton#rebuild:hover { color: #004b86; text-decoration: underline; }

/* Create / Edit Snippet: restrained metadata, compact toolbar, focused editor. */
QWidget#CreateSnippetForm QLabel[metadataLabel="true"] { color: #596372; font-size: 12px; font-weight: 600; background: transparent; }
QWidget#CreateSnippetForm QLineEdit, QWidget#CreateSnippetForm QComboBox { background: #e8eaed; color: #28313d; border: 1px solid #c6cbd2; border-radius: 6px; padding: 7px 10px; }
QWidget#CreateSnippetForm QLineEdit:focus, QWidget#CreateSnippetForm QComboBox:focus { border-color: #5683ad; }
QWidget#markdownToolbar { background: #e8eaed; border-radius: 6px; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"] { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 0; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:hover { background: #dce1e7; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:pressed { background: #d6e8fa; }
QWidget#CreateSnippetForm QPushButton[toolbarAction="true"]:focus { border-color: #5683ad; }
QFrame#toolbarSeparator { background: #c6cbd2; border: none; min-width: 1px; max-width: 1px; min-height: 18px; max-height: 18px; margin: 0 4px; }
QWidget#CreateSnippetForm QPlainTextEdit#content, QWidget#CreateSnippetForm QTextBrowser#preview_browser { background: #ffffff; color: #28313d; border: 1px solid #c6cbd2; border-radius: 7px; padding: 14px; selection-background-color: #d6e8fa; selection-color: #202020; }
QWidget#CreateSnippetForm QPlainTextEdit#content { font-family: "JetBrains Mono", Consolas, monospace; font-size: 14px; font-weight: 400; }
QWidget#CreateSnippetForm QPlainTextEdit#content:focus { border-color: #5683ad; }
QWidget#CreateSnippetForm QTextBrowser#preview_browser { font-family: "Segoe UI"; font-size: 13px; }
QWidget#CreateSnippetForm QPushButton#cancel, QWidget#CreateSnippetForm QPushButton#save { border-radius: 6px; padding: 7px 18px; }
QWidget#CreateSnippetForm QPushButton#cancel { background: transparent; color: #28313d; border: 1px solid #c6cbd2; }
QWidget#CreateSnippetForm QPushButton#cancel:hover { background: #dce1e7; }
QWidget#CreateSnippetForm QPushButton#save { background: #286394; color: #ffffff; border: 1px solid #286394; font-weight: 600; }
QWidget#CreateSnippetForm QPushButton#save:hover { background: #205580; border-color: #205580; }
QWidget#CreateSnippetForm QPushButton#save:pressed { background: #194567; border-color: #194567; }
QWidget#CreateSnippetForm QPushButton#cancel:focus, QWidget#CreateSnippetForm QPushButton#save:focus { border-color: #5683ad; }

/* Snippet details follows the editor's surfaces and action hierarchy. */
QWidget#SnippetDetails QLabel { background: transparent; color: #28313d; font-size: 14px; }
QWidget#SnippetDetails QLabel#title { font-size: 20px; font-weight: 600; }
QWidget#SnippetDetails QWidget#metadataPanel { background: #e8eaed; border-radius: 6px; }
QWidget#SnippetDetails QWidget#tags { background: transparent; }
QWidget#SnippetDetails QLabel[metadataLabel="true"] { color: #596372; font-size: 12px; }
QWidget#SnippetDetails QLabel[tagBadge="true"] { background: #dce1e7; border-radius: 4px; padding: 3px 8px; font-size: 12px; }
QWidget#SnippetDetails QPushButton { border-radius: 6px; padding: 7px 18px; }
QWidget#SnippetDetails QPushButton#close { background: transparent; color: #28313d; border: 1px solid #c6cbd2; }
QWidget#SnippetDetails QPushButton#close:hover { background: #dce1e7; }
QWidget#SnippetDetails QPushButton#edit { background: #286394; color: #ffffff; border: 1px solid #286394; font-weight: 600; }
QWidget#SnippetDetails QPushButton#edit:hover { background: #205580; border-color: #205580; }
QWidget#SnippetDetails QPushButton#edit:pressed { background: #194567; border-color: #194567; }
QWidget#SnippetDetails QPushButton:focus { border-color: #5683ad; }

/* Snips screen shell only: child search and card styling stays independent. */
QWidget#SnippetsScreen QWidget#wdg_sidebar, QWidget#SnippetsScreen QScrollArea#scl_categories, QWidget#SnippetsScreen QWidget#categories_content { background: #e8eaed; }
QWidget#SnippetsScreen QWidget#wdg_main_content, QWidget#SnippetsScreen QWidget#search_holder, QWidget#SnippetsScreen QScrollArea#scl_snippets, QWidget#SnippetsScreen QWidget#snippets_content { background: #f0f0f0; }
QWidget#SnippetsScreen QSplitter#frm_splitter::handle { background: #c6cbd2; }
QWidget#SnippetsScreen QSplitter#frm_splitter::handle:hover { background: #5683ad; }
QWidget#SnippetsScreen QLabel#lbl_app_name { background: transparent; color: #28313d; font-size: 18px; font-weight: 600; padding: 0 10px 12px; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"], QWidget#SnippetsScreen QPushButton[categoryNav="true"] { background: transparent; color: #596372; border: 1px solid transparent; border-radius: 6px; padding: 6px 10px; text-align: left; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"][navRtl="true"], QWidget#SnippetsScreen QPushButton[categoryNav="true"][navRtl="true"] { text-align: right; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:hover, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:hover { background: #dce1e7; color: #28313d; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:pressed, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:pressed { background: #d6e8fa; color: #202020; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"]:checked { background: #d6e8fa; color: #28313d; font-weight: 600; }
QWidget#SnippetsScreen QPushButton[categoryNav="true"]:checked:hover { background: #c6dff5; }
QWidget#SnippetsScreen QPushButton[sidebarNav="true"]:focus, QWidget#SnippetsScreen QPushButton[categoryNav="true"]:focus { border-color: #5683ad; }
QWidget#SnippetsScreen QPushButton#menu::menu-indicator { image: none; }
QWidget#SnippetsScreen QLabel#category_title { background: transparent; color: #28313d; font-size: 20px; font-weight: 600; }
QWidget#SnippetsScreen QLabel#snippets_empty { color: #596372; }
QWidget#SnippetsScreen QPushButton#create { background: #286394; color: #ffffff; border: 1px solid #286394; border-radius: 6px; padding: 7px 18px; font-weight: 600; }
QWidget#SnippetsScreen QPushButton#create:hover { background: #205580; border-color: #205580; }
QWidget#SnippetsScreen QPushButton#create:pressed { background: #194567; border-color: #194567; }
QWidget#SnippetsScreen QPushButton#create:focus { border-color: #5683ad; }
